<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.demo</groupId>
        <artifactId>inbox-outbox-architecture</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>common-events</artifactId>
    <name>common-events</name>
    <description>Shared event contracts: the Avro schemas published on Kafka, the SpecificRecord classes
        generated from them, and the in-process event records. No Spring, no persistence.</description>

    <dependencies>
        <!-- Only for the @OutboxEvent annotation on declaratively-published events.
             Brings no Spring context with it. -->
        <dependency>
            <groupId>io.namastack</groupId>
            <artifactId>namastack-outbox-api</artifactId>
        </dependency>
        <!-- Runtime for the generated SpecificRecord classes (SpecificRecordBase, logical-type
             conversions for BigDecimal and Instant). -->
        <dependency>
            <groupId>org.apache.avro</groupId>
            <artifactId>avro</artifactId>
        </dependency>

        <!-- ===== test ===== -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- No spring-boot-maven-plugin here: this is a plain library jar, and Boot 4 only repackages
         where the plugin is declared explicitly. -->
    <build>
        <plugins>
            <!-- Generates com.demo.events.avro.* from src/main/avro/*.avsc at generate-sources and
                 registers the output directory as a compile source root. -->
            <plugin>
                <groupId>org.apache.avro</groupId>
                <artifactId>avro-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>schema</goal>
                        </goals>
                        <configuration>
                            <sourceDirectory>${project.basedir}/src/main/avro</sourceDirectory>
                            <outputDirectory>${project.build.directory}/generated-sources/avro</outputDirectory>
                            <!-- java.lang.String fields instead of CharSequence/Utf8, so the mapper
                                 and the inbox (which rejects blank ids) work on plain Strings. -->
                            <stringType>String</stringType>
                            <!-- decimal logical type -> java.math.BigDecimal instead of raw bytes. -->
                            <enableDecimalLogicalType>true</enableDecimalLogicalType>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
