<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.demo</groupId>
    <artifactId>inbox-outbox-architecture</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>inbox-outbox-architecture</name>
    <description>Transactional outbox (namastack) + idempotent inbox POC on Java 25 / Spring Boot 4 / Confluent Kafka</description>

    <modules>
        <module>common-events</module>
        <module>inbox-support</module>
        <module>order-service</module>
        <module>shipping-service</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- namastack-outbox 1.8.0 builds against spring-boot-dependencies 4.1.0,
             which is exactly the parent version above. Keep them in lockstep. -->
        <namastack-outbox.version>1.8.0</namastack-outbox.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.namastack</groupId>
                <artifactId>namastack-outbox-bom</artifactId>
                <version>${namastack-outbox.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
